if(NOT DEFINED PROJECT_OPTIONS_CONAN_RUNTIME_LIB_DIRS)
  message(FATAL_ERROR "PROJECT_OPTIONS_CONAN_RUNTIME_LIB_DIRS must be defined")
endif()
if(NOT DEFINED PROJECT_OPTIONS_CONAN_RUNTIME_DESTINATION)
  message(FATAL_ERROR "PROJECT_OPTIONS_CONAN_RUNTIME_DESTINATION must be defined")
endif()

file(MAKE_DIRECTORY "${PROJECT_OPTIONS_CONAN_RUNTIME_DESTINATION}")
foreach(_runtime_dir IN LISTS PROJECT_OPTIONS_CONAN_RUNTIME_LIB_DIRS)
  file(GLOB _runtime_libraries LIST_DIRECTORIES false "${_runtime_dir}/*.dll")
  foreach(_runtime_library IN LISTS _runtime_libraries)
    file(COPY "${_runtime_library}" DESTINATION "${PROJECT_OPTIONS_CONAN_RUNTIME_DESTINATION}")
  endforeach()
endforeach()
